// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "./prisma-client"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  ROOT
  USER
}

model User {
  id              String            @id @default(cuid())
  username        String
  email           String            @unique
  password        String
  createdAt       DateTime          @default(now())
  libraries       Libraries[]
  userPermissions UserPermissions[]
  followingSeries FollowingSeries[]
  readChapters    ReadChapters[]
  role  UserRole @default(USER)
}

enum TypePermission {
  READ
  WRITE
  DELETE
}

enum MediaType {
  IMAGE
  EPUB
}

model Permissions {
  id              String            @id @default(cuid())
  name            String
  type            TypePermission
  userPermissions UserPermissions[]

  @@unique([name, type])
}

model UserPermissions {
  user         User        @relation(fields: [idUser], references: [id])
  idUser       String
  permission   Permissions @relation(fields: [idPermission], references: [id])
  idPermission String

  @@id([idUser, idPermission])
}

model Libraries {
  id                String              @id @default(cuid())
  name              String
  user              User                @relation(fields: [idUser], references: [id])
  idUser            String
  isPublic          Boolean             @default(false)
  createdAt         DateTime            @default(now())
  librariesOnSeries LibrariesOnSeries[]
}

model Series {
  id                String              @id @default(cuid())
  title             String              @unique
  description       String
  pictureUrl        String              @default("")
  author            String
  createdAt         DateTime            @default(now())
  publicationDate   DateTime
  category          Categories          @relation(fields: [idCategory], references: [id])
  idCategory        String
  chapters          Chapter[]
  tagsOnSeries      TagsOnSeries[]
  librariesOnSeries LibrariesOnSeries[]
  followingSeries   FollowingSeries[]
}

model LibrariesOnSeries {
  serie     Series    @relation(fields: [idSerie], references: [id])
  idSerie   String
  library   Libraries @relation(fields: [idLibrary], references: [id])
  idLibrary String

  @@id([idSerie, idLibrary])
}

model Categories {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  series    Series[]
}

model Tags {
  id           String         @id @default(cuid())
  name         String         @unique
  createdAt    DateTime       @default(now())
  tagsOnSeries TagsOnSeries[]
}

model TagsOnSeries {
  series   Series @relation(fields: [idSeries], references: [id])
  idSeries String
  tag      Tags   @relation(fields: [idTag], references: [id])
  idTag    String

  @@id([idSeries, idTag])
}

model Chapter {
  id        String    @id @default(cuid())
  series    Series    @relation(fields: [idSeries], references: [id])
  idSeries  String
  media     Media[]
  title     String
  number    Float
  groupNum    Float?
  groupTitle  String?
  createdAt   DateTime  @default(now())
  readBy    ReadChapters[]
}

model Media {
  id         String    @id @default(cuid())
  chapter    Chapter   @relation(fields: [idChapter], references: [id])
  idChapter  String
  pageNumber Float
  url        String
  type       String
  createdAt  DateTime  @default(now())
}

model FollowingSeries {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [idUser], references: [id])
  idUser    String
  serie     Series   @relation(fields: [idSerie], references: [id])
  idSerie   String
  createdAt DateTime @default(now())

  @@unique([idUser, idSerie])
}

model ReadChapters {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [idUser], references: [id])
  idUser    String
  chapter   Chapter  @relation(fields: [idChapter], references: [id])
  idChapter String
  readAt    DateTime @default(now())

  @@unique([idUser, idChapter])
}
